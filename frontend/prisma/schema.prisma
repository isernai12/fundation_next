generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

// -----------------------------------------------------------------------------
// CORE ENTITIES
// -----------------------------------------------------------------------------

model Foundation {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?
  updatedBy   String?

  groups    Group[]
  documents Document[]
}

model Group {
  id           String   @id @default(uuid())
  foundationId String
  name         String
  code         String   @unique
  shortName    String?
  description  String?
  remarks      String?
  status              String   @default("ACTIVE")
  isFoundationGroup   Boolean  @default(false)
  memberSignupEnabled Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  createdBy           String?
  updatedBy           String?

  foundation Foundation @relation(fields: [foundationId], references: [id], onDelete: Restrict)
  members    Member[]
  funds      Fund[]
  documents  Document[]

  @@index([isFoundationGroup])
}

model Member {
  id       String  @id @default(uuid())
  memberId String  @unique
  groupId  String
  fullName String?

  // Personal Information
  fatherName     String?
  motherName     String?
  gender         String?
  dob            DateTime?
  nationalId     String?   @unique
  idDocumentType String?   @default("NID")
  occupation     String?
  monthlyIncome  Int?
  bloodGroup     String?

  // Contact Information
  mobile           String? @unique
  altMobile        String?
  email            String? @unique
  phone            String?
  presentAddress   String?
  permanentAddress String?

  // Emergency Contact
  emergencyContactName     String?
  emergencyContactMobile   String?
  emergencyContactRelation String?

  // Organization Information
  joinDate DateTime?
  status   String    @default("ACTIVE")
  position String?   @default("GENERAL_MEMBER")
  remarks  String?

  // Extended Information
  maritalStatus       String?
  education           String?
  workplace           String?
  designation         String?
  skills              String?
  reference           String?
  reasonForJoining    String?
  participation       String?
  declarationAccepted Boolean @default(true)
  memberType          String? @default("REGULAR")

  // Outstanding and Dues
  paidUntilMonth Int?
  paidUntilYear  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  group                 Group                  @relation(fields: [groupId], references: [id], onDelete: Restrict)
  beneficiaries         Beneficiary[]
  contributions         MonthlyContribution[]
  campaignContributions CampaignContribution[]
  loans                 Loan[]
  documents             Document[]
  statusHistory         MemberStatusHistory[]
  donations             LedgerTransaction[]
}

model Beneficiary {
  id            String  @id @default(uuid())
  beneficiaryId String  @unique
  memberId      String?
  fullName      String

  email                 String?
  phone                 String?
  mobile                String?
  address               String?
  presentAddress        String?
  permanentAddress      String?
  nationalId            String? @unique
  idDocumentType        String? @default("NID")
  fatherOrHusbandName   String?
  beneficiaryPhoto      String?
  nidOrBirthCertificate String?
  occupation            String?
  remarks               String?
  relationToMember      String?

  assistanceType   String?
  assistanceReason String?
  loanReason       String?
  businessType     String?
  loanPurpose      String?
  loanAmount       Int?

  emergencyContactName     String?
  emergencyContactRelation String?
  emergencyContactMobile   String?
  status                   String   @default("ACTIVE")
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  createdBy                String?
  updatedBy                String?

  member              Member?              @relation(fields: [memberId], references: [id], onDelete: SetNull)
  loans               Loan[]
  grants              Grant[]
  documents           Document[]
  beneficiaryPayments BeneficiaryPayment[]
}

model Donor {
  id         String   @id @default(uuid())
  donorId    String   @unique
  fullName   String
  mobile     String   @unique
  address    String?
  nationalId String?  @unique
  notes      String?
  status     String   @default("ACTIVE")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  createdBy  String?
  updatedBy  String?

  documents             Document[]
  campaignContributions CampaignContribution[]
  donations             LedgerTransaction[]
}

// -----------------------------------------------------------------------------
// FINANCIAL & FUND ENTITIES
// -----------------------------------------------------------------------------

model Fund {
  id          String   @id @default(uuid())
  groupId     String? // If null, represents the Foundation's general fund
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?
  updatedBy   String?

  group       Group?           @relation(fields: [groupId], references: [id], onDelete: Restrict)
  ledgerLines LedgerEntry[]
  allocations FundAllocation[]
}

model MonthlyContribution {
  id             String   @id @default(uuid())
  memberId       String
  month          Int
  year           Int
  expectedAmount Int
  isAdditional   Boolean  @default(false)
  status         String   @default("PENDING")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      String?
  updatedBy      String?

  member   Member                @relation(fields: [memberId], references: [id], onDelete: Restrict)
  payments ContributionPayment[]

  @@unique([memberId, month, year, isAdditional])
}

model ContributionPayment {
  id                    String   @id @default(uuid())
  monthlyContributionId String
  ledgerTransactionId   String   @unique
  amount                Int
  paymentDate           DateTime
  paymentMethod         String
  referenceNumber       String?
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  createdBy             String?
  updatedBy             String?

  monthlyContribution MonthlyContribution @relation(fields: [monthlyContributionId], references: [id], onDelete: Restrict)
  ledgerTransaction   LedgerTransaction   @relation(fields: [ledgerTransactionId], references: [id], onDelete: Restrict)
}

// -----------------------------------------------------------------------------
// LEDGER (SINGLE SOURCE OF TRUTH)
// -----------------------------------------------------------------------------

model LedgerTransaction {
  id          String   @id @default(uuid())
  date        DateTime
  type        String
  referenceId String? // Polymorphic link, handled in app logic (no explicit FK to keep generic)
  memberId    String?
  donorId     String?
  status      String   @default("COMPLETED")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?
  updatedBy   String?

  member               Member?                @relation(fields: [memberId], references: [id], onDelete: SetNull)
  donor                Donor?                 @relation(fields: [donorId], references: [id], onDelete: SetNull)
  entries              LedgerEntry[]
  contributionPayment  ContributionPayment?
  loanRepayment        LoanRepayment?
  campaignContribution CampaignContribution?
  beneficiaryPayment   BeneficiaryPayment?

  @@index([memberId])
  @@index([donorId])
}

model LedgerEntry {
  id            String   @id @default(uuid())
  transactionId String
  fundId        String
  isCredit      Boolean // True = Credit (+), False = Debit (-)
  amount        Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdBy     String?
  updatedBy     String?

  groupId   String?
  groupCode String?
  groupName String?

  transaction LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  fund        Fund              @relation(fields: [fundId], references: [id], onDelete: Restrict)

  @@index([fundId])
  @@index([transactionId])
}

// -----------------------------------------------------------------------------
// LOANS & GRANTS
// -----------------------------------------------------------------------------

model Loan {
  id            String    @id @default(uuid())
  loanNumber    String    @unique
  memberId      String?
  beneficiaryId String?
  amount        Int
  loanType      String    @default("OTHER") // "BUSINESS" | "OTHER"
  businessType  String?
  purpose       String
  requestedDate DateTime  @default(now())
  disbursedDate DateTime?

  status String  @default("ACTIVE")
  notes  String?

  // New Fields for Installment Schedule & Balance
  installmentType      String? // DAILY, WEEKLY, MONTHLY, CUSTOM
  installmentAmount    Int?
  totalInstallments    Int?
  firstInstallmentDate DateTime?
  nextDueDate          DateTime?
  totalPaidAmount      Int       @default(0)
  remainingBalance     Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  member      Member?          @relation(fields: [memberId], references: [id], onDelete: Restrict)
  beneficiary Beneficiary?     @relation(fields: [beneficiaryId], references: [id], onDelete: Restrict)
  allocations FundAllocation[]
  repayments  LoanRepayment[]
  documents   Document[]

  @@index([memberId])
  @@index([beneficiaryId])
}

model LoanRepayment {
  id                  String   @id @default(uuid())
  loanId              String
  ledgerTransactionId String   @unique
  amount              Int
  date                DateTime
  status              String   @default("COMPLETED")

  // New Fields for Repayment
  installmentNo   Int?
  paymentMethod   String  @default("CASH") // CASH, BANK, MOBILE
  referenceNumber String?
  notes           String?
  collectedBy     String?
  receiptUrl      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  loan              Loan              @relation(fields: [loanId], references: [id], onDelete: Restrict)
  ledgerTransaction LedgerTransaction @relation(fields: [ledgerTransactionId], references: [id], onDelete: Restrict)
}

model Grant {
  id            String    @id @default(uuid())
  grantNumber   String    @unique
  beneficiaryId String
  amount        Int
  purpose       String
  dateApproved  DateTime?
  disbursedDate DateTime?
  status        String    @default("PENDING")
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdBy     String?
  updatedBy     String?

  beneficiary Beneficiary      @relation(fields: [beneficiaryId], references: [id], onDelete: Restrict)
  allocations FundAllocation[]
  documents   Document[]
}

model FundAllocation {
  id         String   @id @default(uuid())
  fundId     String
  targetType String // Typically LOAN or GRANT
  loanId     String?
  grantId    String?
  amount     Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  createdBy  String?
  updatedBy  String?

  fund  Fund   @relation(fields: [fundId], references: [id], onDelete: Restrict)
  loan  Loan?  @relation(fields: [loanId], references: [id], onDelete: Cascade)
  grant Grant? @relation(fields: [grantId], references: [id], onDelete: Cascade)

  @@index([fundId])
  @@index([loanId])
  @@index([grantId])
}

// -----------------------------------------------------------------------------
// SYSTEM ENTITIES
// -----------------------------------------------------------------------------

model DocumentCategory {
  id          String     @id @default(uuid())
  name        String     @unique
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  documents   Document[]
}

model Document {
  id                 String  @id @default(uuid())
  documentNumber     String  @unique
  title              String
  categoryId         String?
  type               String
  cloudinaryPublicId String
  secureUrl          String
  originalFilename   String
  mimeType           String
  sizeBytes          Int
  resourceType       String  @default("auto")
  targetType         String
  entityId           String? // Virtual ID for polymorphic relations if needed

  description String?
  remarks     String?
  status      String  @default("ACTIVE")

  foundationId         String?
  groupId              String?
  memberId             String?
  beneficiaryId        String?
  loanId               String?
  grantId              String?
  donorId              String?
  campaignId           String?
  beneficiaryPaymentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  category           DocumentCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  foundation         Foundation?         @relation(fields: [foundationId], references: [id], onDelete: Cascade)
  group              Group?              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  member             Member?             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  beneficiary        Beneficiary?        @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  loan               Loan?               @relation(fields: [loanId], references: [id], onDelete: Cascade)
  grant              Grant?              @relation(fields: [grantId], references: [id], onDelete: Cascade)
  donor              Donor?              @relation(fields: [donorId], references: [id], onDelete: Cascade)
  campaign           Campaign?           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  beneficiaryPayment BeneficiaryPayment? @relation(fields: [beneficiaryPaymentId], references: [id], onDelete: Cascade)

  @@index([foundationId])
  @@index([groupId])
  @@index([memberId])
  @@index([beneficiaryId])
  @@index([loanId])
  @@index([grantId])
  @@index([donorId])
  @@index([campaignId])
  @@index([beneficiaryPaymentId])
  @@index([targetType])
}

// -----------------------------------------------------------------------------
// CAMPAIGNS (তহবিল কার্যক্রম)
// -----------------------------------------------------------------------------

model Campaign {
  id           String    @id @default(uuid())
  campaignId   String    @unique
  name         String
  purpose      String
  description  String?
  targetAmount Int?
  startDate    DateTime
  endDate      DateTime?
  status       String    @default("ACTIVE") // ACTIVE, COMPLETED, CANCELLED
  remarks      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdBy    String?
  updatedBy    String?

  contributions       CampaignContribution[]
  beneficiaryPayments BeneficiaryPayment[]
  documents           Document[]
}

model BeneficiaryPayment {
  id                  String   @id @default(uuid())
  campaignId          String
  beneficiaryId       String
  ledgerTransactionId String   @unique
  amount              Int
  date                DateTime
  reason              String
  referenceNumber     String?
  comments            String?
  status              String   @default("COMPLETED")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  createdBy           String?
  updatedBy           String?

  campaign          Campaign          @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  beneficiary       Beneficiary       @relation(fields: [beneficiaryId], references: [id], onDelete: Restrict)
  ledgerTransaction LedgerTransaction @relation(fields: [ledgerTransactionId], references: [id], onDelete: Restrict)
  documents         Document[]

  @@index([campaignId])
  @@index([beneficiaryId])
}

model CampaignContribution {
  id                  String   @id @default(uuid())
  campaignId          String
  memberId            String?
  donorId             String?
  ledgerTransactionId String   @unique
  amount              Int
  date                DateTime
  remarks             String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  createdBy           String?
  updatedBy           String?

  campaign          Campaign          @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  member            Member?           @relation(fields: [memberId], references: [id], onDelete: SetNull)
  donor             Donor?            @relation(fields: [donorId], references: [id], onDelete: SetNull)
  ledgerTransaction LedgerTransaction @relation(fields: [ledgerTransactionId], references: [id], onDelete: Restrict)

  @@index([campaignId])
  @@index([memberId])
  @@index([donorId])
}

model Settings {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?
  updatedBy   String?
}

// -----------------------------------------------------------------------------
// AUTHENTICATION & AUTHORIZATION
// -----------------------------------------------------------------------------

model User {
  id          String    @id @default(uuid())
  name        String
  username    String    @unique
  email       String?   @unique
  mobile      String?   @unique
  password    String
  roleId      String
  status      String    @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED
  lastLogin   DateTime?
  photo       String?
  preferences String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  role            Role             @relation(fields: [roleId], references: [id], onDelete: Restrict)
  auditLogs       AuditLog[]
  sessions        UserSession[]
  userPermissions UserPermission[]
}

model UserSession {
  id         String   @id @default(uuid())
  userId     String
  jti        String   @unique
  device     String?
  browser    String?
  os         String?
  ipAddress  String?
  lastActive DateTime @default(now())
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique // SUPER_ADMIN, ADMIN, MANAGER, OPERATOR, VIEWER
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions RolePermission[]
}

model Permission {
  id          String  @id @default(uuid())
  module      String // Members, Groups, Contributions, etc.
  action      String // Create, Read, Update, Delete, Approve, Export, Print
  description String?

  roles           RolePermission[]
  userPermissions UserPermission[]

  @@unique([module, action])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

// -----------------------------------------------------------------------------
// AUDIT LOG
// -----------------------------------------------------------------------------

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  action      String
  module      String
  referenceId String?
  oldValue    String?
  newValue    String?
  ipAddress   String?
  device      String?
  browser     String?
  remarks     String?
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// -----------------------------------------------------------------------------
// SYSTEM ADMINISTRATION
// -----------------------------------------------------------------------------

model SystemSettings {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  group     String // System, Contribution, Loan, Document, Preferences
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model FoundationProfile {
  id                 String   @id @default(uuid())
  name               String
  logo               String?
  address            String?
  phone              String?
  email              String?
  website            String?
  registrationNumber String?
  description        String?
  currency           String   @default("USD")
  timezone           String   @default("UTC")
  language           String   @default("en")
  status             String   @default("ACTIVE")
  updatedAt          DateTime @updatedAt
  updatedBy          String?
}

model UserPermission {
  userId       String
  permissionId String

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
}

model MemberStatusHistory {
  id         String   @id @default(uuid())
  memberId   String
  fromStatus String
  toStatus   String
  reason     String?
  notes      String?
  changedBy  String?
  changedAt  DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
}

// -----------------------------------------------------------------------------
// MEMBER REQUEST (Public Application)
// -----------------------------------------------------------------------------

model MemberRequest {
  id                String   @id @default(uuid())
  applicationNumber String   @unique
  status            String   @default("PENDING") // PENDING, APPROVED, REJECTED, NEEDS_CHANGES

  // Personal Information (mirrors Member fields)
  fullName         String
  fatherName       String?
  motherName       String?
  gender           String?
  dob              String?
  nationalId       String?
  idDocumentType   String?  @default("NID")
  occupation       String?
  monthlyIncome    Int?
  bloodGroup       String?
  education        String?
  maritalStatus    String?

  // Contact Information
  mobile           String?
  altMobile        String?
  email            String?
  phone            String?
  presentAddress   String?
  permanentAddress String?

  // Emergency Contact
  emergencyContactName     String?
  emergencyContactMobile   String?
  emergencyContactRelation String?

  // Reference / Nominee
  referenceName     String?
  referenceMobile   String?
  referenceRelation String?

  // Organization
  groupId          String?
  reasonForJoining String?

  // Documents stored as JSON array of { title, cloudinaryPublicId, secureUrl }
  documents String? // JSON

  // Admin workflow
  rejectionReason  String?
  adminMessage     String?
  approvedAt       DateTime?
  approvedBy       String?
  createdMemberId  String?

  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([applicationNumber])
}
